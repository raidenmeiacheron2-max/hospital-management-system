# 环境变量示例文件
# 复制为 .env.local（已被 .gitignore 忽略）后按需修改；
# 本项目为纯前端 Mock 演示，不包含任何真实密钥或后端地址。
NODE_ENV=development
VUE_APP_TITLE=医院管理系统
VUE_APP_BASE_API=/api

# ===== AI（B3）：默认本地确定性引擎，零网络、零密钥 =====
VUE_APP_AI_ENABLED=true
VUE_APP_AI_PROVIDER=local
# 仅 http-llm 使用；默认空 = 不联网
VUE_APP_AI_ENDPOINT=
# 密钥只能放 .env.local（已忽略），不得提交或写入种子
