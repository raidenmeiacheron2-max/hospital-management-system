NODE_ENV=development
VUE_APP_TITLE=医院管理系统
VUE_APP_BASE_API=/api
# ===== AI（B3）：默认本地确定性引擎，零网络、零密钥 =====
# 总开关：false 时所有 AI 入口无副作用（页面显示已关闭）
VUE_APP_AI_ENABLED=true
# Provider：local（默认，本地确定性规则引擎）/ http-llm（仅骨架，默认禁用）
VUE_APP_AI_PROVIDER=local
# 仅 http-llm 使用；默认空 = 不联网。密钥类配置只能放 .env.local（已忽略），不得入库
VUE_APP_AI_ENDPOINT=
